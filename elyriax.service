[Unit]
Description=Elyriax API v3.0 (Rust Axum Service)
After=network.target mysql.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/elyriax-api-rust
EnvironmentFile=/root/elyriax-api-rust/.env
ExecStart=/root/elyriax-api-rust/target/release/elyriax-api

Restart=always
RestartSec=3
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
