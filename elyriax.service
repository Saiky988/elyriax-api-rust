[Unit]
Description=Elyriax API v3.0 (Rust Axum Service)
After=network.target mysql.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/Elyriax-api
EnvironmentFile=/root/Elyriax-api/.env
ExecStart=/root/Elyriax-api/target/release/elyriax-api

Restart=always
RestartSec=3
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
