# Server Configuration
PORT=25243
HOST=0.0.0.0
ENVIRONMENT=production
RUST_LOG=info,elyriax_api=debug,sqlx=warn
BASE_URL=https://apis.elyriax.com
FRONTEND_URL=https://elyriax.com
GO_BASE_URL=https://go.elyriax.com
TZ=Asia/Ho_Chi_Minh

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=elyriax_user
DB_PASSWORD=change_me_strong_password
DB_NAME=elyriax_db
DB_CONNECTION_LIMIT=20

# Security (DO NOT change GENSHIN_COOKIE_SECRET if DB already has encrypted cookies!)
JWT_SECRET=change_me_jwt_secret_at_least_32_chars
GENSHIN_COOKIE_SECRET=change_me_cookie_secret_keep_existing_if_migrating

# OAuth Providers (Login & Account Linking)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Payment (SePay & VietQR)
SEPAY_WEBHOOK_TOKEN=
BANK_ID=MB
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=

# Static Admin Auth
ADMIN_USERNAME=elyriax
ADMIN_PASSWORD=change_me_admin_password
ADMIN_TOKEN=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Elyriax <no-reply@elyriax.com>
